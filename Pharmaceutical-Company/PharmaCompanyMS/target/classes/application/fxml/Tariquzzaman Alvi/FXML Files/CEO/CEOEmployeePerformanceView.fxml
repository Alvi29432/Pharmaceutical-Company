<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.chiefexecutiveofficer.CEOEmployeePerformanceController"
      spacing="10" style="-fx-padding: 10;">
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>
    <Label text="Employee Performance Reports" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <VBox>
            <Label text="Average Score" style="-fx-font-weight: bold;"/>
            <Label fx:id="avgScoreLabel" text="0.00" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Top Performer" style="-fx-font-weight: bold;"/>
            <Label fx:id="topEmployeeLabel" text="-" style="-fx-font-size: 22px;"/>
        </VBox>
        <Button text="Refresh" onAction="#loadAll"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label text="Sort by:"/>
        <ComboBox fx:id="sortBox" prefWidth="160"/>
    </HBox>

    <TableView fx:id="performanceTable" prefHeight="380">
        <columns>
            <TableColumn fx:id="empCol"    text="Employee ID" prefWidth="140"/>
            <TableColumn fx:id="periodCol" text="Period"      prefWidth="140"/>
            <TableColumn fx:id="scoreCol"  text="Score"       prefWidth="120"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>