<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.accountant.AccountantAccountsPayableController"
      spacing="10" style="-fx-padding: 10;">

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>

    <Label text="Accounts Payable" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="25" alignment="CENTER_LEFT">
        <VBox>
            <Label text="Total Owed" style="-fx-font-weight: bold;"/>
            <Label fx:id="totalLabel" text="0.00" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Outstanding" style="-fx-font-weight: bold;"/>
            <Label fx:id="outstandingLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Paid" style="-fx-font-weight: bold;"/>
            <Label fx:id="paidLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <Button text="Refresh" onAction="#loadPayables"/>
    </HBox>

    <Separator/>

    <Label text="Add Payable" style="-fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120"/>
            <ColumnConstraints minWidth="260" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Vendor:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="vendorField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Supplier name"/>

        <Label text="Amount:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="amountField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="0.00"/>

        <Label text="Due Date:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="dueField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="2026-08-30"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Add Payable" onAction="#handleAdd" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
        <Button text="Mark Paid" onAction="#handleMarkPaid" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
        <Button text="Delete Selected" onAction="#handleDelete" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <TableView fx:id="payableTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="idCol"      text="Payable ID" prefWidth="140"/>
            <TableColumn fx:id="vendorCol"  text="Vendor"     prefWidth="220"/>
            <TableColumn fx:id="amountCol"  text="Amount"     prefWidth="140"/>
            <TableColumn fx:id="dueCol"     text="Due Date"   prefWidth="160"/>
            <TableColumn fx:id="statusCol"  text="Status"     prefWidth="140"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>