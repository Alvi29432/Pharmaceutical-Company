<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.accountant.AccountantComplianceController"
      spacing="10" style="-fx-padding: 10;">

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>

    <Label text="Compliance" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="25" alignment="CENTER_LEFT">
        <VBox>
            <Label text="Total Records" style="-fx-font-weight: bold;"/>
            <Label fx:id="totalLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Open" style="-fx-font-weight: bold;"/>
            <Label fx:id="openLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Resolved" style="-fx-font-weight: bold;"/>
            <Label fx:id="resolvedLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <Button text="Refresh" onAction="#loadCompliance"/>
    </HBox>

    <Separator/>

    <Label text="Add Compliance Record" style="-fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120"/>
            <ColumnConstraints minWidth="260" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Regulation:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="regulationField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="e.g. FDA 21 CFR Part 11"/>

        <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="descField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Brief detail"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Add Record" onAction="#handleAdd" style="-fx-background-color: #8e44ad; -fx-text-fill: white;"/>
        <Button text="Resolve Selected" onAction="#handleResolve" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
        <Button text="Delete Selected" onAction="#handleDelete" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <TableView fx:id="complianceTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="idCol"         text="Record ID"   prefWidth="140"/>
            <TableColumn fx:id="regulationCol" text="Regulation"  prefWidth="240"/>
            <TableColumn fx:id="descCol"       text="Description" prefWidth="320"/>
            <TableColumn fx:id="statusCol"     text="Status"      prefWidth="140"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>