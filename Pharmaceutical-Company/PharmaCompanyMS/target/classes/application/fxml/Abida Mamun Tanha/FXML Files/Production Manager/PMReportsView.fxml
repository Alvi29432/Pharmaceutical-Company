<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.productionmanager.PMReportsController"
      spacing="10" style="-fx-padding: 10;">

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>

    <Label text="Production Reports" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="25" alignment="CENTER_LEFT">
        <VBox>
            <Label text="Total Batches" style="-fx-font-weight: bold;"/>
            <Label fx:id="totalBatchesLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Target Units" style="-fx-font-weight: bold;"/>
            <Label fx:id="targetUnitsLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Completed Units" style="-fx-font-weight: bold;"/>
            <Label fx:id="completedUnitsLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Overall Completion" style="-fx-font-weight: bold;"/>
            <Label fx:id="overallLabel" text="0%" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Defected (Failed Inspections)" style="-fx-font-weight: bold;"/>
            <Label fx:id="defectedLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <Button text="Refresh" onAction="#loadReports"/>
    </HBox>

    <Separator/>

    <Label text="Per-Batch Report" style="-fx-font-weight: bold;"/>
    <TableView fx:id="reportTable" prefHeight="340">
        <columns>
            <TableColumn fx:id="batchCol"     text="Batch ID"      prefWidth="140"/>
            <TableColumn fx:id="medicineCol"  text="Medicine"      prefWidth="220"/>
            <TableColumn fx:id="qtyCol"       text="Target Qty"    prefWidth="100"/>
            <TableColumn fx:id="completedCol" text="Completed"     prefWidth="120"/>
            <TableColumn fx:id="percentCol"   text="Progress"      prefWidth="120"/>
            <TableColumn fx:id="statusCol"    text="Status"        prefWidth="140"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>