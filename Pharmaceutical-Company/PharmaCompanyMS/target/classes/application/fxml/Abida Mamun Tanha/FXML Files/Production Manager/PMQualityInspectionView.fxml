<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.productionmanager.PMQualityInspectionController"
      spacing="10" style="-fx-padding: 10;">

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>

    <Label text="Quality Inspection" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="25" alignment="CENTER_LEFT">
        <VBox>
            <Label text="Total Inspections" style="-fx-font-weight: bold;"/>
            <Label fx:id="totalLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Pass" style="-fx-font-weight: bold;"/>
            <Label fx:id="passLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Fail" style="-fx-font-weight: bold;"/>
            <Label fx:id="failLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <Button text="Refresh" onAction="#loadInspections"/>
    </HBox>

    <Separator/>

    <Label text="Record New Inspection" style="-fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120"/>
            <ColumnConstraints minWidth="260" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Batch:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="batchBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="320"/>

        <Label text="Result:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="resultBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="160"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Record Inspection" onAction="#handleRecord" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <TableView fx:id="inspectionTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="idCol"      text="Inspection ID" prefWidth="160"/>
            <TableColumn fx:id="batchCol"   text="Batch ID"      prefWidth="160"/>
            <TableColumn fx:id="resultCol"  text="Result"        prefWidth="160"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>