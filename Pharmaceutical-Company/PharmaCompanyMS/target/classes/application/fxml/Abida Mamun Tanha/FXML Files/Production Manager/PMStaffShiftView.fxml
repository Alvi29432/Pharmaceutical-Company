<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.productionmanager.PMStaffShiftController"
      spacing="10" style="-fx-padding: 10;">

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>

    <Label text="Staff Shift" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Button text="Refresh" onAction="#loadShifts"/>
    </HBox>

    <Separator/>

    <Label text="Assign New Shift" style="-fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120"/>
            <ColumnConstraints minWidth="260" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Employee:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="employeeField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Full name"/>

        <Label text="Date (YYYY-MM-DD):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="dateField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="2026-08-01"/>

        <Label text="Shift:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="shiftBox" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="160"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Assign Shift" onAction="#handleAssign" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <TableView fx:id="shiftTable" prefHeight="320">
        <columns>
            <TableColumn fx:id="idCol"      text="Shift ID"   prefWidth="120"/>
            <TableColumn fx:id="empCol"     text="Employee"   prefWidth="220"/>
            <TableColumn fx:id="dateCol"    text="Date"       prefWidth="160"/>
            <TableColumn fx:id="typeCol"    text="Shift"      prefWidth="160"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>