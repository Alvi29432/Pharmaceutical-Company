<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.customer.CustomerCreateAccountController"
      spacing="10" style="-fx-padding: 10;"
      prefWidth="560" prefHeight="380" minWidth="560" maxWidth="560" minHeight="380" maxHeight="380">

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Login" onAction="#goBackToLogin"/>
    </HBox>

    <Label text="Create New Customer Account" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120"/>
            <ColumnConstraints minWidth="280" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Confirm Password:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <PasswordField fx:id="confirmField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Full Name:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="fullNameField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Create Account" onAction="#handleCreate" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
        <Button text="Reset" onAction="#handleReset"/>
    </HBox>

    <Label fx:id="infoLabel" text=""/>
</VBox>