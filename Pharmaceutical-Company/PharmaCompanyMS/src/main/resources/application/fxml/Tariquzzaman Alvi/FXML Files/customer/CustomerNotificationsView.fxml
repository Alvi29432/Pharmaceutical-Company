<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.customer.CustomerNotificationsController"
      spacing="10" style="-fx-padding: 10;">
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>
    <Label text="Notifications" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="25" alignment="CENTER_LEFT">
        <VBox>
            <Label text="Total" style="-fx-font-weight: bold;"/>
            <Label fx:id="totalLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <Button text="Refresh" onAction="#loadNotifications"/>
    </HBox>

    <Separator/>

    <TableView fx:id="notificationTable" prefHeight="380">
        <columns>
            <TableColumn fx:id="idCol"       text="Notification ID" prefWidth="140"/>
            <TableColumn fx:id="recipientCol" text="Recipient"       prefWidth="200"/>
            <TableColumn fx:id="messageCol"  text="Message"          prefWidth="500"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>