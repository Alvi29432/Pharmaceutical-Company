<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.chiefexecutiveofficer.CEOInventoryController"
      spacing="10" style="-fx-padding: 10;">
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>
    <Label text="Inventory Monitoring" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Show:"/>
        <ComboBox fx:id="filterBox" prefWidth="160"/>
        <Button text="Refresh" onAction="#loadInventory"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label text="Threshold:"/>
        <TextField fx:id="thresholdField" prefWidth="80" text="50"/>
        <Button text="Update" onAction="#handleUpdateThreshold"/>
    </HBox>

    <TableView fx:id="inventoryTable" prefHeight="380">
        <columns>
            <TableColumn fx:id="idCol"    text="Item ID"     prefWidth="100"/>
            <TableColumn fx:id="medCol"   text="Medicine ID" prefWidth="120"/>
            <TableColumn fx:id="stockCol" text="Stock"       prefWidth="100"/>
            <TableColumn fx:id="statusCol" text="Status"     prefWidth="160"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>