<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.customer.CustomerSupportTicketsController"
      spacing="10" style="-fx-padding: 10;">
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>
    <Label text="Support Tickets" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Describe your issue:"/>
    </HBox>
    <TextArea fx:id="issueArea" prefRowCount="4" promptText="What can we help you with?" wrapText="true"/>

    <HBox spacing="10">
        <Button text="Submit Ticket" onAction="#handleSubmit" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
        <Button text="Refresh List" onAction="#loadTickets"/>
        <Button text="Clear" onAction="#handleClear"/>
    </HBox>

    <Separator/>

    <Label text="My Tickets" style="-fx-font-weight: bold;"/>

    <TableView fx:id="ticketTable" prefHeight="280">
        <columns>
            <TableColumn fx:id="idCol"    text="Ticket ID" prefWidth="120"/>
            <TableColumn fx:id="custCol"  text="Customer"  prefWidth="160"/>
            <TableColumn fx:id="issueCol" text="Issue"     prefWidth="500"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>