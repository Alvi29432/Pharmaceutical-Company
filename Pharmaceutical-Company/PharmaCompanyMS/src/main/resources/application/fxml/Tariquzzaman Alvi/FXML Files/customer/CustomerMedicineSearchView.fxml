<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.customer.CustomerMedicineSearchController"
      spacing="10" style="-fx-padding: 10;">
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>
    <Label text="Medicine Search" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Keyword:"/>
        <TextField fx:id="keywordField" promptText="name or id" prefWidth="200"/>
        <Label text="Category:"/>
        <ComboBox fx:id="categoryBox" prefWidth="160"/>
        <Button text="Search" onAction="#handleSearch" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
        <Button text="Show All" onAction="#handleShowAll"/>
    </HBox>

    <TableView fx:id="medicineTable" prefHeight="380">
        <columns>
            <TableColumn fx:id="idCol"       text="ID"        prefWidth="100"/>
            <TableColumn fx:id="nameCol"     text="Name"      prefWidth="260"/>
            <TableColumn fx:id="categoryCol" text="Category"  prefWidth="180"/>
            <TableColumn fx:id="priceCol"    text="Price ($)" prefWidth="120"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>