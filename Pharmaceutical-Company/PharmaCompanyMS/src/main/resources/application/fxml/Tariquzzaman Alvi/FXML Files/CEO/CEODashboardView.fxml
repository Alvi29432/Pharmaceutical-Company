<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.controllers.chiefexecutiveofficer.CEODashboardController"
            prefWidth="1100" prefHeight="680">

    <!-- Top bar: greeting + logout -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Label fx:id="welcomeLabel" text="Welcome, CEO"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <!-- Left navigation menu -->
    <left>
        <VBox spacing="8" style="-fx-background-color: #ecf0f1; -fx-padding: 15;">
            <Label text="CEO Modules" style="-fx-font-weight: bold;"/>
            <Button text="Dashboard Stats"   prefWidth="180" onAction="#showDashboardStats"/>
            <Button text="Policy Approval"   prefWidth="180" onAction="#showPolicyApproval"/>
            <Button text="Budget Approval"   prefWidth="180" onAction="#showBudgetApproval"/>
            <Button text="Inventory Monitor" prefWidth="180" onAction="#showInventory"/>
            <Button text="Production Monitor" prefWidth="180" onAction="#showProduction"/>
            <Button text="Customer Satisfaction" prefWidth="180" onAction="#showCustomerSatisfaction"/>
            <Button text="Employee Performance" prefWidth="180" onAction="#showEmployeePerformance"/>
            <Button text="Reports"           prefWidth="180" onAction="#showReports"/>
        </VBox>
    </left>

    <!-- Center: each module page is loaded into this container -->
    <center>
        <VBox fx:id="contentArea" alignment="CENTER" spacing="10" style="-fx-padding: 15;">
            <Label text="CEO Dashboard" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Select a module from the left to begin."/>
        </VBox>
    </center>

</BorderPane>
