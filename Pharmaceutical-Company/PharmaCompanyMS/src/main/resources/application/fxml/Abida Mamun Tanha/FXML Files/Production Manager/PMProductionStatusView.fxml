<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.productionmanager.PMProductionStatusController"
      spacing="10" style="-fx-padding: 10;">

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>

    <Label text="Production Status" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="25" alignment="CENTER_LEFT">
        <VBox>
            <Label text="Planned" style="-fx-font-weight: bold;"/>
            <Label fx:id="plannedLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="In Progress" style="-fx-font-weight: bold;"/>
            <Label fx:id="inProgressLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Completed" style="-fx-font-weight: bold;"/>
            <Label fx:id="completedLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <Button text="Refresh" onAction="#loadStatus"/>
    </HBox>

    <Separator/>

    <Label text="Batch + Schedule Status" style="-fx-font-weight: bold;"/>
    <TableView fx:id="statusTable" prefHeight="380">
        <columns>
            <TableColumn fx:id="batchCol"     text="Batch ID"     prefWidth="140"/>
            <TableColumn fx:id="medicineCol"  text="Medicine"     prefWidth="220"/>
            <TableColumn fx:id="qtyCol"       text="Qty"          prefWidth="80"/>
            <TableColumn fx:id="statusCol"    text="Batch Status" prefWidth="140"/>
            <TableColumn fx:id="scheduleCol"  text="Scheduled"    prefWidth="160"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>