<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.productionmanager.PMInventoryMonitoringController"
      spacing="10" style="-fx-padding: 10;">

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Back to Dashboard" onAction="#goBackToDashboard"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>

    <Label text="Inventory Monitoring" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="25" alignment="CENTER_LEFT">
        <VBox>
            <Label text="Items" style="-fx-font-weight: bold;"/>
            <Label fx:id="itemCountLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Low Stock" style="-fx-font-weight: bold;"/>
            <Label fx:id="lowStockLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <VBox>
            <Label text="Out of Stock" style="-fx-font-weight: bold;"/>
            <Label fx:id="outOfStockLabel" text="0" style="-fx-font-size: 22px;"/>
        </VBox>
        <Button text="Refresh" onAction="#loadInventory"/>
    </HBox>

    <Separator/>

    <TableView fx:id="inventoryTable" prefHeight="380">
        <columns>
            <TableColumn fx:id="idCol"        text="Item ID"    prefWidth="120"/>
            <TableColumn fx:id="medicineCol"  text="Medicine"   prefWidth="280"/>
            <TableColumn fx:id="stockCol"     text="Stock"      prefWidth="120"/>
            <TableColumn fx:id="statusCol"    text="Status"     prefWidth="160"/>
        </columns>
    </TableView>

    <Label fx:id="infoLabel" text=""/>
</VBox>